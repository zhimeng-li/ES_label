# Reusable plotting function
make_boxplot <- function(data, variable, title) {
ggplot(
data,
aes(
x = condition,
y = .data[[variable]],
fill = color_order
)
) +
geom_boxplot() +
scale_fill_viridis(discrete = TRUE, alpha = 0.6) +
geom_jitter(
color = "black",
size = 0.4,
alpha = 0.9
) +
theme_bw(base_size = 16) +
theme(
legend.position = "none",
plot.title = element_text(size = 11),
panel.border = element_blank()
) +
ggtitle(title) +
xlab("")
}
# 1. Accuracy, sensitivity, and criterion
p_accuracy <- make_boxplot(
FULL,
"accuracy",
"Accuracy by condition"
)
p_sensitivity <- make_boxplot(
FULL,
"dprime",
"Sensitivity by condition"
)
p_criterion <- make_boxplot(
FULL,
"c",
"Criterion by condition"
)
p_performance <- p_accuracy + p_sensitivity + p_criterion
ggsave(
"visual/accuracy_sensitivity_criterion.pdf",
plot = p_performance,
width = 15,
height = 5
)
# 2. Consensus Event Agreement
p_CEA <- make_boxplot(
FULL,
"CEA_ave",
"Consensus Event Agreement by condition"
)
ggsave(
"visual/CEA_boxplot.pdf",
plot = p_CEA,
width = 5,
height = 5
)
# 3. Segmentation number and mean length unit
p_segnum <- make_boxplot(
FULL,
"SegNum_ave",
"Segmentation Number by condition"
)
p_MLU <- make_boxplot(
FULL,
"MLU_ave",
"Mean length unit by condition"
)
p_segmentation <- p_segnum + p_MLU
ggsave(
"visual/segnum_MLU.pdf",
plot = p_segmentation,
width = 10,
height = 5
)
make_boxplot <- function(
data,
variable,
title,
comparisons = NULL,
annotations = NULL
) {
p <- data %>%
ggplot(
aes(
x = condition,
y = .data[[variable]]
)
) +
geom_boxplot(aes(fill = color_order)) +
scale_fill_viridis(discrete = TRUE, alpha = 0.6) +
geom_jitter(
color = "black",
size = 0.4,
alpha = 0.9
) +
scale_y_continuous(
expand = expansion(mult = c(0.05, 0.25))
) +
coord_cartesian(clip = "off") +
theme_bw(base_size = 16) +
theme(
legend.position = "none",
plot.title = element_text(size = 11),
panel.border = element_blank(),
plot.margin = margin(t = 15, r = 5, b = 5, l = 5)
) +
ggtitle(title) +
xlab("")
if (!is.null(comparisons)) {
p <- p +
geom_signif(
comparisons = comparisons,
annotations = annotations,
map_signif_level = FALSE,
step_increase = 0.10,
margin_top = 0.05,
tip_length = 0.01,
textsize = 5
)
}
return(p)
}
make_boxplot <- function(
data,
variable,
title,
comparisons = NULL,
annotations = NULL
) {
p <- data %>%
ggplot(
aes(
x = condition,
y = .data[[variable]]
)
) +
geom_boxplot(aes(fill = color_order)) +
scale_fill_viridis(discrete = TRUE, alpha = 0.6) +
geom_jitter(
color = "black",
size = 0.4,
alpha = 0.9
) +
scale_y_continuous(
expand = expansion(mult = c(0.05, 0.25))
) +
coord_cartesian(clip = "off") +
theme_bw(base_size = 16) +
theme(
legend.position = "none",
plot.title = element_text(size = 11),
panel.border = element_blank(),
plot.margin = margin(t = 15, r = 5, b = 5, l = 5)
) +
ggtitle(title) +
xlab("")
if (!is.null(comparisons)) {
p <- p +
geom_signif(
comparisons = comparisons,
annotations = annotations,
map_signif_level = FALSE,
step_increase = 0.10,
margin_top = 0.05,
tip_length = 0.01,
textsize = 5
)
}
return(p)
}
# Accuracy
p_accuracy <- make_boxplot(
FULL, "accuracy", "Accuracy by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("WithLabel", "Counting"),
c("NoLabel", "Counting")
),
annotations = c("*", "***", "*")
)
# Sensitivity
p_sensitivity <- make_boxplot(
FULL, "dprime", "Sensitivity by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("WithLabel", "Counting")
),
annotations = c("**", "***")
)
# Criterion
p_criterion <- make_boxplot(
FULL, "c", "Criterion by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("NoLabel", "Counting")
),
annotations = c("***", "***")
)
# Consensus Event Agreement
p_CEA <- make_boxplot(
FULL, "CEA_ave", "Consensus Event Agreement by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("WithLabel", "Counting"),
c("NoLabel", "Counting")
),
annotations = c("***", "***", "**")
)
# Segmentation number
p_segnum <- make_boxplot(
FULL, "SegNum_ave", "Segmentation Number by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("NoLabel", "Counting")
),
annotations = c("***", "***")
)
# Mean length unit
p_MLU <- make_boxplot(
FULL, "MLU_ave", "Mean Length Unit by condition",
comparisons = list(
c("NoLabel", "WithLabel"),
c("NoLabel", "Counting")
),
annotations = c("***", "***")
)
# STEU total score
p_STEU <- make_boxplot(
FULL, "STEU_score", "STEU Score by condition",
comparisons = list(
c("NoLabel", "WithLabel")
),
annotations = "**"
)
p_STEU_sub <- make_boxplot(
FULL,
variable = "STEU_sub_score",
title = "STEU Subscore by condition"
)
p_STEU_untrained <- make_boxplot(
FULL,
variable = "STEU_untrained",
title = "STEU Untrained Score by condition"
)
p_total_word <- make_boxplot(
FULL,
variable = "total_word",
title = "Total Words by condition"
)
p_unique_word <- make_boxplot(
FULL,
variable = "total_unique_word",
title = "Total Unique Words by condition"
)
# STEU measures: one PDF with three panels
p_STEU_group <- p_STEU + p_STEU_sub + p_STEU_untrained
ggsave(
filename = "visual/STEU_measures.pdf",
plot = p_STEU_group,
width = 15,
height = 5
)
